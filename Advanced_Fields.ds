		workflow
		{
		form
		{
			auto_calculate_total_payable as "Auto-calculate Total Payable"
			{
				type =  form
				form = room_booking

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch all room inventory records to get tariff information
										roomInventoryList = room_inventory[ID != 0];
										// Initialize total amount variable
										totalAmount = 0;
										// Iterate through each room in the booking to calculate total tariff
										for each  room in roomInventoryList
										{
											// Get the tariff per night for the current room
											tariffPerNight = room.tariff_per_night;
											// Add the tariff to the total amount
											totalAmount = totalAmount + tariffPerNight;
										}
										// Set the calculated total amount to the form field
										input.total_amount_payable = totalAmount;
										// Log the calculated total amount for debugging
										info "Calculated Total Amount: " + totalAmount.toString();
						)
					}
				}

			}
			block_invalid_booking_submission as "Block Invalid Booking Submission"
			{
				type =  form
				form = room_booking

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if advance payment is zero or missing
										if(input.advance_payment_paid == null || input.advance_payment_paid == 0 || input.advance_payment_paid.isBlank())
										{
											alert "Error: Advance payment is required. Please provide a valid advance payment amount.";
											cancel submit;
										}
										// Check if ID proof is missing
										if(input.id_proof_upload == null || input.id_proof_upload.isBlank())
										{
											alert "Error: ID proof upload is required. Please upload a valid ID proof.";
											cancel submit;
										}
						)
					}
				}

			}
			send_booking_confirmation_email as "Send Booking Confirmation Email"
			{
				type =  form
				form = room_booking

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the booking confirmation QR code from the current form
										qrCode = input.booking_confirmation_qr_code;
										// Fetch the travel itinerary URL from the current form
										itineraryUrl = input.travel_itinerary_url;
										// Get guest name components from the composite NAME field
										guestName = input.guest_name.first_name;
										// Get guest email from the current form
										guestEmail = input.email;
										// Validate that guest email is not null before sending
										if(guestEmail.isNull())
										{
											info "Guest email is missing, cannot send confirmation email";
										}
										else
										{
											// Construct email message with QR code and itinerary
											emailSubject = "Your Booking Confirmation - " + qrCode;
											emailMessage = "<p>Dear " + guestName + ",</p>" + "<p>Your booking has been successfully confirmed.</p>" + "<p>Please find your booking confirmation QR code attached.</p>" + "<p>Travel Itinerary: " + itineraryUrl + "</p>" + "<p>Thank you for choosing our hotel!</p>";
											// Send email to the guest with QR code and itinerary
											sendmail
											[
												from :zoho.loginuserid
												to :guestEmail
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_room_availability_sync as "Daily Room Availability Sync"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch room inventory records with Maintenance status
										maintenanceRooms = room_inventory[availability_status == "Maintenance"];
										// Check if any maintenance rooms exist
										if(maintenanceRooms.count() > 0)
										{
											// Prepare notification message
											notificationMessage = "<p>The following rooms are currently in Maintenance status:</p>";
											for each  room in maintenanceRooms
											{
												notificationMessage = notificationMessage.concat("<p>Room Number: ").concat(room.room_number).concat(" - Room Type: ").concat(room.room_type).concat("</p>");
											}
											notificationMessage = notificationMessage.concat("<p>Please take necessary action.</p>");
											// Send notification email to admin user
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Room Maintenance Alert"
												message :notificationMessage
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


