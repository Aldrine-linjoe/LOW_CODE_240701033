 application "Hotel Room Booking Front Office Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form additional_guests
		{
			displayname = "Additional Guests Details"
			success message = "Additional Guests Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			primary_booking
			(
				type = list	
				displayname = "Primary Booking"
				values  = room_booking.ID
    			displayformat = [booking_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest_name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest_age
			(
				type = number
				displayname = "Guest Age"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_type
			(
    			type = text
				displayname = "ID Type"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form room_booking
		{
			displayname = "Room Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			guest_name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type_lookup
			(
				type = list	
				displayname = "Room Type Availability Lookup"
				values  = room_inventory.ID
    			displayformat = [room_type]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			requires_airport_pickup
			(
    			type = checkbox
				displayname = "Requires Airport Pickup"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			hotel_policies_display
			(
    			type = textarea
				displayname = "Hotel Policies Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			travel_itinerary_url
			(
    			type = url
				displayname = "Travel Itinerary URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest_photo
			(
    			type = text
				displayname = "Guest Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			loyalty_discount_percent
			(
    			type = percentage
				displayname = "Loyalty Discount Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			advance_payment_paid
			(
				displayname = "Advance Payment Paid"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			distance_from_airport_km
			(
				type = decimal
				displayname = "Distance From Airport KM"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_submitted_on
			(
    			type = datetime
				displayname = "Booking Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			additional_guests
			(
				type = list	
				displayname = "Additional Guests Details"
				values  = additional_guests.ID
    			displayformat = [guest_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount_payable
			(
				displayname = "Total Amount Payable"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_id
			(
    			type = autonumber
				displayname = "Booking ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_confirmation_qr_code
			(
    			type = text
				displayname = "Booking Confirmation QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest_digital_signature
			(
    			type = text
				displayname = "Guest Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_proof_upload
			(
    			type = text
				displayname = "ID Proof Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			special_request_voice_note
			(
    			type = text
				displayname = "Special Request Voice Note"
	 			row = 1
	 			column = 1   
				width = medium
			)
			celebration_request_video
			(
    			type = text
				displayname = "Celebration Request Video"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Draft","Booking Submitted","Pending Payment","Booking Cancelled","Pending Approval","Booking Confirmed","Pre-Arrival Preparation","Guest Checked In","Guest Stay Active","Guest Checked Out","Booking Extended","Booking Closed","Pending Final Payment","Booking Disputed"}
			}
		}
		form room_inventory
		{
			displayname = "Room Inventory"
			success message = "Room Inventory Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			room_type
			(
    			type = text
				displayname = "Room Type"
	 			row = 1
	 			column = 1   
				width = medium
			)
			tariff_per_night
			(
				displayname = "Tariff Per Night"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			availability_status
			(
				type = picklist
				displayname = "Availability Status"
				values = {"Occupied","Booked","Available","Maintenance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_number
			(
    			type = text
				displayname = "Room Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Inventory Record Created","Availability Verified","Inventory Pending Review","Inventory Active","Room Occupied","Room Maintenance Required","Room Checked Out"}
			}
		}
	}
	reports
	{
		list room_booking_Report
		{
			displayName = "Room Booking Report"
			show all rows from room_booking    
			(
				guest_name  as "Guest Name"
				email as "Email"
				phone_number as "Phone Number"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				room_type_lookup as "Room Type Availability Lookup"
				requires_airport_pickup as "Requires Airport Pickup"
				hotel_policies_display as "Hotel Policies Display"
				travel_itinerary_url as "Travel Itinerary URL"
				guest_photo as "Guest Photo"
				loyalty_discount_percent as "Loyalty Discount Percent"
				(
					display = total,average,min,max	
				)
				advance_payment_paid as "Advance Payment Paid"
				(
					display = total,average,min,max	
				)
				distance_from_airport_km as "Distance From Airport KM"
				booking_submitted_on as "Booking Submitted On"
				additional_guests as "Additional Guests Details"
				total_amount_payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				booking_id as "Booking ID"
				booking_confirmation_qr_code as "Booking Confirmation QR Code"
				guest_digital_signature as "Guest Digital Signature"
				id_proof_upload as "ID Proof Upload"
				special_request_voice_note as "Special Request Voice Note"
				celebration_request_video as "Celebration Request Video"
			)
		}
		list room_inventory_Report
		{
			displayName = "All Room Inventories"
			show all rows from room_inventory    
			(
				room_type as "Room Type"
				tariff_per_night as "Tariff Per Night"
				(
					display = total,average,min,max	
				)
				availability_status as "Availability Status"
				room_number as "Room Number"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (availability_status == "Booked")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (availability_status == "Maintenance")
				fields = [availability_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (availability_status == "Occupied")
				fields = [availability_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban room_inventory_by_availability_status
		{
			displayName = "Availability Statuses"
			show all rows from room_inventory    
			(
				room_type as "Room Type"
				tariff_per_night as "Tariff Per Night"
				(
					display = total,average,min,max	
				)
				availability_status as "Availability Status"
				room_number as "Room Number"
			)
			options
			(
	 			display field = availability_status
	 		)
		}
		list additional_guests_Report
		{
			displayName = "All Additional Guests Details"
			show all rows from additional_guests    
			(
				primary_booking as "Primary Booking"
				guest_name  as "Guest Name"
				guest_age as "Guest Age"
				id_type as "ID Type"
			)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
