		workflow
		{
		form
		{
			auto_set_booking_status as "Auto-Set Booking Status on Check-In"
			{
				type =  form
				form = booking

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Check if the booking record exists and has a valid ID
										if(input.ID.isValidObject())
										{
											// Set the status field to Checked-In
											input.status = "Checked-In";
										}
						)
					}
				}

			}
			validate_checkout_date as "Validate Check-Out Date Logic"
			{
				type =  form
				form = booking

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate that check-out date is not before check-in date
										if(input.check_out_date.isDate() && input.check_in_date.isDate())
										{
											checkInDate = input.check_in_date;
											checkOutDate = input.check_out_date;
											// Calculate days between check-in and check-out
											daysDifference = checkInDate.daysBetween(checkOutDate);
											// If check-out is before check-in, daysDifference will be negative
											if(daysDifference < 0)
											{
												alert "Error: Check-out date cannot be before check-in date. Please correct the dates and try again.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_housekeeping_new_booking as "Notify Housekeeping on New Booking"
			{
				type =  form
				form = booking

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the booking record to get guest and room details
										bookingRecord = booking[ID == input.ID];
										// Get guest names from multi-select lookup
										guestNames = "";
										for each  guest in bookingRecord.guest
										{
											if(guestNames.isEmpty())
											{
												guestNames = input.guest.guest_name.first_name + " " + input.guest.guest_name.last_name;
											}
											else
											{
												guestNames = guestNames.concat(", ") + input.guest.guest_name.first_name + " " + input.guest.guest_name.last_name;
											}
										}
										// Get room type names from multi-select lookup
										roomNames = "";
										for each  room in bookingRecord.room_type
										{
											if(roomNames.isEmpty())
											{
												roomNames = room.type_name;
											}
											else
											{
												roomNames = roomNames.concat(", ") + room.type_name;
											}
										}
										// Prepare notification message
										notificationMessage = "<p>Dear Housekeeping Team,</p>" + "<p>A new booking has been created with the following details:</p>" + "<p><strong>Guest(s):</strong> " + guestNames + "</p>" + "<p><strong>Room Type(s):</strong> " + roomNames + "</p>" + "<p><strong>Check-in Date:</strong> " + bookingRecord.check_in_date.toString() + "</p>" + "<p><strong>Check-out Date:</strong> " + bookingRecord.check_out_date.toString() + "</p>" + "<p>Please prepare the rooms accordingly.</p>";
										// Send notification email to housekeeping team
										sendmail
										[
											from :zoho.loginuserid
											to :zoho.adminuserid
											subject :"New Booking Created - Housekeeping Notification"
											message :notificationMessage
											content type :HTML
										]
						)
					}
				}

			}
		}

		schedule
		{
			daily_checkin_reminder as "Daily Check-In Reminder Email"
			{
				type =  schedule
				form = booking
					status = inactive
				start = check_in_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch bookings with check-in date as tomorrow
										bookings = booking[check_in_date == tomorrow];
										// Iterate through each booking to send reminder emails
										for each  booking in bookings
										{
											// Get guest details from multi-select lookup
											for each  guest in booking.guest
											{
												// Validate guest email is not null or empty
												if(guest.email.isNull() || guest.email.isEmpty())
												{
													continue;
												}
												// Prepare email subject
												subject = "Reminder: Your Check-in is Tomorrow";
												// Prepare email message with guest and booking details
												message = "Dear " + input.guest.guest_name.first_name + " " + input.guest.guest_name.last_name + ",\n\n";
												message = message.concat("This is a friendly reminder that your check-in is scheduled for tomorrow.\n");
												message = message.concat("Booking ID: " + booking.booking_id.toString() + "\n");
												message = message.concat("Room Type: " + booking.room_type.type_name + "\n\n");
												message = message.concat("We look forward to welcoming you!\n\n");
												message = message.concat("Best regards,\nHotel Management Team");
												// Send email reminder
												sendmail
												[
													from :zoho.loginuserid
													to :input.guest.email
													subject :subject
													message :message
												]
											}
										}
					)
					}
				}
			}
		}


