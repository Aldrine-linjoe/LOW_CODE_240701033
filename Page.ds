 application "Hotel Room Booking Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form booking_reminder_log
		{
			displayname = "Booking Reminder Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			booking
			(
				type = list	
				displayname = "Booking"
				values  = booking.ID
    			displayformat = [booking_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			reminder_sent
			(
    			type = checkbox
				displayname = "Reminder Sent"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			sent_time
			(
    			type = datetime
				displayname = "Sent Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			recipient_email
			(
    			type = email
				displayname = "Recipient Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form guest_profile
		{
			displayname = "Guest Profile"
			success message = "Guest Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			guest_name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_proof_document
			(
    			type = url
				displayname = "ID Proof Document"
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_proof_filename
			(
    			type = text
				displayname = "ID Proof Filename"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form policy_snippet
		{
			displayname = "Hotel Policy Snippet"
			success message = "Hotel Policy Snippet Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			check_in_terms
			(
    			type = textarea
				displayname = "Check In Terms"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_out_terms
			(
    			type = textarea
				displayname = "Check Out Terms"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			cancellation_terms
			(
    			type = textarea
				displayname = "Cancellation Terms"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = datetime
				displayname = "Last Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form housekeeping_log
		{
			displayname = "Housekeeping Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			booking
			(
				type = list	
				displayname = "Booking"
				values  = booking.ID
    			displayformat = [booking_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_number
			(
    			type = text
				displayname = "Room Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Ready","In-Progress","Dirty"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			updated_by
			(
    			type = text
				displayname = "Updated By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			updated_time
			(
    			type = datetime
				displayname = "Updated Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Room Dirty","Cleaning In Progress","Room Maintenance Required","Cleaning Completed","Quality Inspection Pending","Room Ready","Room Occupied","Room Reserved","Maintenance In Progress"}
			}
		}
		form booking
		{
			displayname = "Room Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			booking_id
			(
    			type = autonumber
				displayname = "Booking ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest
			(
				type = list	
				displayname = "Guest"
				values  = guest_profile.ID
    			displayformat = [guest_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type
			(
				type = list	
				displayname = "Room Type"
				values  = room_type.ID
    			displayformat = [type_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_date
			(
    			type = date
				displayname = "Check In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_out_date
			(
    			type = date
				displayname = "Check Out Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Enquiry","Checked-In","Checked-Out","Confirmed"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount
			(
				displayname = "Total Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_walk_in
			(
    			type = checkbox
				displayname = "Is Walk In"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = text
				displayname = "Created By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_time
			(
    			type = datetime
				displayname = "Created Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Enquiry","Booking Confirmed","Booking Pending Payment","Booking Cancelled","Booking Pre-Arrival","Guest Checked In","Booking On Hold","Guest In Stay","Early Check Out","Guest Checked Out","Guest Extended Stay","Guest Early Check Out","Booking Closed","Booking Dispute","Booking Refunded"}
			}
		}
		form room_type
		{
			displayname = "Room Type"
			success message = "Room Type Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			type_name
			(
    			type = text
				displayname = "Type Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			base_rate
			(
				displayname = "Base Rate"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_rooms
			(
				type = number
				displayname = "Total Rooms"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list booking_Report
		{
			displayName = "Room Booking Report"
			show all rows from booking    
			(
				booking_id as "Booking ID"
				guest as "Guest"
				room_type as "Room Type"
				check_in_date as "Check In Date"
				check_out_date as "Check Out Date"
				status as "Status"
				total_amount as "Total Amount"
				(
					display = total,average,min,max	
				)
				is_walk_in as "Is Walk In"
				created_by as "Created By"
				created_time as "Created Time"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Checked-Out")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Confirmed")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Enquiry")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban booking_by_status
		{
			displayName = "Statuses"
			show all rows from booking    
			(
				booking_id as "Booking ID"
				guest as "Guest"
				room_type as "Room Type"
				check_in_date as "Check In Date"
				check_out_date as "Check Out Date"
				status as "Status"
				total_amount as "Total Amount"
				(
					display = total,average,min,max	
				)
				is_walk_in as "Is Walk In"
				created_by as "Created By"
				created_time as "Created Time"
			)
			options
			(
	 			display field = status
	 		)
		}
		list housekeeping_log_Report
		{
			displayName = "Housekeeping Log Report"
			show all rows from housekeeping_log    
			(
				booking as "Booking"
				room_number as "Room Number"
				status as "Status"
				updated_by as "Updated By"
				updated_time as "Updated Time"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Dirty")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "In-Progress")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Ready")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban housekeeping_log_by_status
		{
			displayName = "Statuses"
			show all rows from housekeeping_log    
			(
				booking as "Booking"
				room_number as "Room Number"
				status as "Status"
				updated_by as "Updated By"
				updated_time as "Updated Time"
			)
			options
			(
	 			display field = status
	 		)
		}
		list booking_reminder_log_Report
		{
			displayName = "Booking Reminder Log Report"
			show all rows from booking_reminder_log    
			(
				booking as "Booking"
				reminder_sent as "Reminder Sent"
				sent_time as "Sent Time"
				recipient_email as "Recipient Email"
			)
		}
		list room_type_Report
		{
			displayName = "All Room Types"
			show all rows from room_type    
			(
				type_name as "Type Name"
				base_rate as "Base Rate"
				(
					display = total,average,min,max	
				)
				total_rooms as "Total Rooms"
				description as "Description"
			)
		}
		list policy_snippet_Report
		{
			displayName = "All Hotel Policy Snippets"
			show all rows from policy_snippet    
			(
				check_in_terms as "Check In Terms"
				check_out_terms as "Check Out Terms"
				cancellation_terms as "Cancellation Terms"
				last_updated as "Last Updated"
			)
		}
		list guest_profile_Report
		{
			displayName = "All Guest Profiles"
			show all rows from guest_profile    
			(
				guest_name  as "Guest Name"
				contact_number as "Contact Number"
				email as "Email"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				id_proof_document as "ID Proof Document"
				id_proof_filename as "ID Proof Filename"
			)
		}
	}
	pages
	{
		page DashBoard
		{
