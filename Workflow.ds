 application "Hotel Room Booking Automation Suite"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form Booking_Approvals
		{
			displayname = "Booking Approvals"
			success message = "Approvals Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			booking
			(
				type = list	
				displayname = "Booking"
				values  = Room_Booking_Form.ID
    			displayformat = [booking_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_type
			(
				type = radiobuttons
				displayname = "Approval Type"
				values = {"Complimentary Upgrade","Special Discount"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			requested_by
			(
    			type = text
				displayname = "Requested By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_date
			(
    			type = datetime
				displayname = "Request Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_status
			(
				type = picklist
				displayname = "Approval Status"
				values = {"Approved","Rejected","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			approved_by
			(
    			type = text
				displayname = "Approved By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_date
			(
    			type = datetime
				displayname = "Approval Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_comments
			(
    			type = textarea
				displayname = "Approval Comments"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			fallback_approver
			(
    			type = text
				displayname = "Fallback Approver"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
