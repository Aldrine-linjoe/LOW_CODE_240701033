		workflow
		{
		form
		{
			auto_calculate_total_amount as "Auto-calculate Total Amount"
			{
				type =  form
				form = Room_Booking_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch tariff and discount percentage values from input fields
										tariffValue = input.tariff;
										discountPercentage = input.discount_percentage;
										// Initialize total payable variable
										totalPayable = 0;
										// Calculate discount amount if discount percentage is provided
										if(!input.discount_percentage.isNull())
										{
											discountAmount = (tariffValue * discountPercentage) / 100;
											totalPayable = tariffValue - discountAmount;
										}
										else
										{
											// If no discount, total payable equals tariff
											totalPayable = tariffValue;
										}
										// Set the calculated total payable to the form field
										input.total_amount_payable = totalPayable;
						)
					}
				}

			}
			send_booking_confirmation_email as "Send Booking Confirmation Email"
			{
				type =  form
				form = Room_Booking_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Send confirmation email to guest upon successful booking creation
										if(input.guest_email.isNull())
										{
											info "Guest email is missing, cannot send confirmation email";
										}
										else
										{
											sendmail
											[
												from :zoho.loginuserid
												to :input.guest_email
												subject :"Booking Confirmation - " + input.booking_id.toText()
												message :"Dear " + input.guest_name.first_name + ",\n\nYour booking has been successfully created.\n\nBooking ID: " + input.booking_id.toText() + "\nGuest Name: " + input.guest_name.first_name + " " + input.guest_name.last_name + "\nCheck-in Date: " + input.check_in_date.toString() + "\nCheck-out Date: " + input.check_out_date.toString() + "\nRoom Type: " + input.room_type + "\n\nThank you for choosing us!\n\nBest regards,\nHotel Management Team"
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			pre_checkin_reminder as "Pre-Check-in Reminder"
			{
				type =  schedule
				form = Room_Booking_Form
					status = inactive
				start = check_in_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Get the check-in date from the input record
										checkInDate = input.check_in_date;
										// Calculate the reminder date (one day before check-in)
										reminderDate = checkInDate.addDay(-1);
										// Get the current date
										currentDate = zoho.currentdate;
										// Check if today is the reminder date
										if(currentDate == reminderDate)
										{
											// Get guest details
											guestName = input.guest_name.first_name;
											guestEmail = input.guest_email;
											roomNumber = input.room_number;
											roomType = input.room_type;
											checkInDateFormatted = checkInDate.getDateTime();
											// Prepare email message
											emailSubject = "Reminder: Your Check-In is Tomorrow";
											emailMessage = "Dear " + guestName + ",\n\n" + "This is a friendly reminder that your check-in is scheduled for tomorrow, " + checkInDateFormatted + ".\n\n" + "Your reservation details:\n" + "Room Number: " + roomNumber.toString() + "\n" + "Room Type: " + roomType + "\n\n" + "We look forward to welcoming you!\n\n" + "Best regards,\n" + "Hotel Management Team";
											// Send the reminder email
											sendmail
											[
												from :zoho.loginuserid
												to :guestEmail
												subject :emailSubject
												message :emailMessage
												content type :Plain Text
											]
										}
					)
					}
				}
			}
		}


