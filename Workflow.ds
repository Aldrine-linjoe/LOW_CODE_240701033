	reports
	{
		list Booking_Approvals_Report
		{
			displayName = "All Approvals"
			show all rows from Booking_Approvals    
			(
				booking as "Booking"
				approval_type as "Approval Type"
				requested_by as "Requested By"
				request_date as "Request Date"
				approval_status as "Approval Status"
				approved_by as "Approved By"
				approval_date as "Approval Date"
				approval_comments as "Approval Comments"
				fallback_approver as "Fallback Approver"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (approval_status == "Approved")
				fields = [approval_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (approval_status == "Pending")
				fields = [approval_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (approval_status == "Rejected")
				fields = [approval_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban Booking_Approvals_by_approval_status
		{
			displayName = "Approval Statuses"
			show all rows from Booking_Approvals    
			(
				booking as "Booking"
				approval_type as "Approval Type"
				requested_by as "Requested By"
				request_date as "Request Date"
				approval_status as "Approval Status"
				approved_by as "Approved By"
				approval_date as "Approval Date"
				approval_comments as "Approval Comments"
				fallback_approver as "Fallback Approver"
			)
			options
			(
	 			display field = approval_status
	 		)
		}
		list Feedback_Surveys_Report
		{
			displayName = "All Feedback Surveys"
			show all rows from Feedback_Surveys    
			(
				booking as "Booking"
				survey_link as "Survey Link"
				sent_date as "Sent Date"
				response_status as "Response Status"
				feedback_score as "Feedback Score"
				feedback_comments as "Feedback Comments"
				batch_id as "Batch ID"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (response_status == "Responded")
				fields = [response_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (response_status == "Sent")
				fields = [response_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban Feedback_Surveys_by_response_status
		{
			displayName = "Response Statuses"
			show all rows from Feedback_Surveys    
			(
				booking as "Booking"
				survey_link as "Survey Link"
				sent_date as "Sent Date"
				response_status as "Response Status"
				feedback_score as "Feedback Score"
				feedback_comments as "Feedback Comments"
				batch_id as "Batch ID"
			)
			options
			(
	 			display field = response_status
	 		)
		}
		list Payment_Transactions_Report
		{
			displayName = "All Payment Transactions"
			show all rows from Payment_Transactions    
			(
				booking as "Booking"
				payment_link as "Payment Link"
				amount as "Amount"
				(
					display = total,average,min,max	
				)
				gateway_status as "Gateway Status"
				transaction_reference as "Transaction Reference"
				retry_count as "Retry Count"
				payment_date as "Payment Date"
				error_log as "Error Log"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (gateway_status == "Failed")
				fields = [gateway_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (gateway_status == "Initiated")
				fields = [gateway_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (gateway_status == "Success")
				fields = [gateway_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
