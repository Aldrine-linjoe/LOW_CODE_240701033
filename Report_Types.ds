		workflow
		{
		form
		{
			validate_checkout_date as "Validate Check-out Date"
			{
				type =  form
				form = Room_Booking_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate that check-out date is not before check-in date
										if(input.check_out_date.isDate() && input.check_in_date.isDate())
										{
											if(input.check_out_date < input.check_in_date)
											{
												alert "Error: Check-out date cannot be before check-in date. Please correct the dates and try again.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			send_booking_confirmation as "Send Booking Confirmation Email"
			{
				type =  form
				form = Room_Booking_Form

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Check if booking status is Confirmed
										if(input.booking_status == "Confirmed")
										{
											// Get guest email from input
											guestEmail = input.email;
											// Get guest name from composite field
											guestName = input.guest_name.first_name;
											// Get booking details
											checkInDate = input.check_in_date;
											checkOutDate = input.check_out_date;
											roomType = input.room_type;
											// Format dates for email
											checkInDateStr = toString(checkInDate,"dd MMM yyyy");
											checkOutDateStr = toString(checkOutDate,"dd MMM yyyy");
											// Construct email message
											emailSubject = "Booking Confirmation - " + guestName;
											emailMessage = "<p>Dear " + guestName + ",</p>" + "<p>Your booking has been confirmed.</p>" + "<p><strong>Booking Details:</strong></p>" + "<ul>" + "<li>Room Type: " + roomType + "</li>" + "<li>Check-in Date: " + checkInDateStr + "</li>" + "<li>Check-out Date: " + checkOutDateStr + "</li>" + "</ul>" + "<p>We look forward to welcoming you!</p>";
											// Send confirmation email
											sendmail
											[
												from :zoho.loginuserid
												to :guestEmail
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_housekeeping_report as "Daily Housekeeping Status Report"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all rooms that need cleaning based on housekeeping status
										roomsNeedingCleaning = Room_Booking_Form[housekeeping_status == "Cleaning" || housekeeping_status == "Pending"];
										// Check if there are any rooms needing cleaning
										if(roomsNeedingCleaning.count() > 0)
										{
											// Build the notification message
											notificationMessage = "<p>Dear Manager,</p>";
											notificationMessage = notificationMessage.concat("<p>The following rooms need cleaning:</p>");
											notificationMessage = notificationMessage.concat("<ul>");
											// Iterate through each room needing cleaning
											for each  room in roomsNeedingCleaning
											{
												// Get guest name from composite field
												guestName = room.guest_name.first_name.concat(" ").concat(room.guest_name.last_name);
												// Get room type
												roomType = room.room_type;
												// Get booking status
												bookingStatus = room.booking_status;
												// Add to message
												notificationMessage = notificationMessage.concat("<li>");
												notificationMessage = notificationMessage.concat("Room Type: ").concat(roomType).concat(" | Guest: ").concat(guestName).concat(" | Status: ").concat(bookingStatus).concat("</li>");
											}
											notificationMessage = notificationMessage.concat("</ul>");
											notificationMessage = notificationMessage.concat("<p>Please ensure these rooms are cleaned promptly.</p>");
											// Send email notification to the logged-in user (manager)
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.loginuserid
												subject :"Daily Room Cleaning Notification"
												message :notificationMessage
												content type :HTML
											]
										}
					)
					}
				}
			}
		}




