 application "Hotel Room Booking Reports Suite"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form Booking_Staff_Assignment
		{
			displayname = "Booking Staff Assignment"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			booking
			(
				type = list	
				displayname = "Booking"
				values  = Room_Booking_Form.ID
    			displayformat = [guest_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_staff
			(
				type = list	
				displayname = "Assigned Staff"
				values  = Staff_Users.ID
    			displayformat = [user_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			assignment_date
			(
    			type = datetime
				displayname = "Assignment Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Created","Staff Assignment Pending","Booking Cancelled","Staff Assigned","Assignment Confirmed","Booking Completed"}
			}
		}
		form Room_Booking_Form
		{
			displayname = "Room Booking Form"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			guest_name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			permanent_address
			(
    			type = address
				displayname = "Permanent Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type
			(
				type = picklist
				displayname = "Room Type"
				values = {"Triple","Suite","Single","Deluxe","Double","Presidential"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			meal_plan
			(
				type = picklist
				displayname = "Meal Plan"
				values = {"Breakfast","All Inclusive","Half Board","Full Board","None"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_date
			(
    			type = date
				displayname = "Check-In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_out_date
			(
    			type = date
				displayname = "Check-Out Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_guests
			(
				type = number
				displayname = "Number Of Guests"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_status
			(
				type = picklist
				displayname = "Booking Status"
				values = {"Enquiry","Checked-In","Checked-Out","Confirmed","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_status
			(
				type = radiobuttons
				displayname = "Check-In Status"
				values = {"Completed","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_out_status
			(
				type = radiobuttons
				displayname = "Check-Out Status"
				values = {"Completed","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			housekeeping_status
			(
				type = picklist
				displayname = "Housekeeping Status"
				values = {"Ready","Occupied","Cleaning","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_submitted_on
			(
    			type = datetime
				displayname = "Booking Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount
			(
				displayname = "Total Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Enquiry","Booking Confirmed","Booking Pending Approval","Booking Cancelled","Booking Rejected","Pre-Arrival","Booking Modified","Guest Checked In","Guest In-Stay","Early Check-Out","Guest Checked Out","Room Cleaning Required","Booking Closed","Room Ready","Room Maintenance"}
			}
		}
		form Staff_Users
		{
			displayname = "Staff Users"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			user_name
			(
    			type = name
				displayname = "User Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			role
			(
				type = picklist
				displayname = "Role"
				values = {"Housekeeping","Owner","Front Office","Manager","Marketing"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"F&B","Management","Operations","Marketing"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list Booking_Staff_Assignment_Report
		{
			displayName = "Booking Staff Assignment Report"
			show all rows from Booking_Staff_Assignment    
			(
				booking as "Booking"
				assigned_staff as "Assigned Staff"
				assignment_date as "Assignment Date"
			)
		}
		list Staff_Users_Report
		{
			displayName = "Staff Users Report"
			show all rows from Staff_Users    
			(
				user_name  as "User Name"
				email as "Email Address"
				role as "Role"
				department as "Department"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (role == "Housekeeping")
				fields = [role]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (role == "Manager")
				fields = [role]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (role == "Marketing")
				fields = [role]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban Staff_Users_by_role
		{
			displayName = "Role"
			show all rows from Staff_Users    
			(
				user_name  as "User Name"
				email as "Email Address"
				role as "Role"
				department as "Department"
			)
			options
			(
	 			display field = role
	 		)
		}
		list Room_Booking_Form_Report
		{
			displayName = "Room Booking Form Report"
			show all rows from Room_Booking_Form    
			(
				guest_name  as "Guest Name"
				contact_number as "Contact Number"
				email as "Email Address"
				permanent_address  as "Permanent Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				room_type as "Room Type"
				meal_plan as "Meal Plan"
				check_in_date as "Check-In Date"
				check_out_date as "Check-Out Date"
				number_of_guests as "Number Of Guests"
				booking_status as "Booking Status"
				check_in_status as "Check-In Status"
				check_out_status as "Check-Out Status"
				housekeeping_status as "Housekeeping Status"
				booking_submitted_on as "Booking Submitted On"
				total_amount as "Total Amount"
				(
					display = total,average,min,max	
				)
				is_active as "Is Active"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (meal_plan == "Full Board")
				fields = [meal_plan]
				format = "color:#ffffff;background-color:#765f89;"
				}
			)
		}
		kanban Room_Booking_Form_by_room_type
		{
			displayName = "Room Type"
			show all rows from Room_Booking_Form    
			(
				guest_name  as "Guest Name"
				contact_number as "Contact Number"
				email as "Email Address"
				permanent_address  as "Permanent Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				room_type as "Room Type"
				meal_plan as "Meal Plan"
				check_in_date as "Check-In Date"
				check_out_date as "Check-Out Date"
				number_of_guests as "Number Of Guests"
				booking_status as "Booking Status"
				check_in_status as "Check-In Status"
				check_out_status as "Check-Out Status"
				housekeeping_status as "Housekeeping Status"
				booking_submitted_on as "Booking Submitted On"
				total_amount as "Total Amount"
				(
					display = total,average,min,max	
				)
				is_active as "Is Active"
			)
			options
			(
	 			display field = room_type
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
