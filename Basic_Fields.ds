		workflow
		{
		form
		{
			auto_fill_guest_email as "Auto-fill Guest Email"
			{
				type =  form
				form = guest_profile

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set the email_address field with the logged-in user's email address
										input.email_address = zoho.loginuserid;
						)
					}
				}

			}
			validate_policy_agreement as "Validate Policy Agreement"
			{
				type =  form
				form = guest_profile

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate if hotel policies are agreed to before allowing form submission
										if(input.agree_to_hotel_policies == false)
										{
											alert "You must agree to the hotel policies to proceed with the booking.";
											cancel submit;
										}
						)
					}
				}

			}
		}






	}
