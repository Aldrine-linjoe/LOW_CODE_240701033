 application "Hotel Room Booking System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form booking_record
		{
			displayname = "Booking Record"
			success message = "Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			guest
			(
				type = list	
				displayname = "Guest"
				values  = guest_profile.ID
    			displayformat = [guest_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_status
			(
				type = picklist
				displayname = "Booking Status"
				values = {"Checked In","Confirmed","Cancelled","Pending","Checked Out"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_at
			(
    			type = datetime
				displayname = "Created At"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Initiated","Guest Profile Created","Booking Pending Review","Booking Confirmed","Booking Rejected","Booking Checked In","Booking Cancelled","Booking Modified","Booking Active","Booking Checked Out","Booking Extended","Booking Closed","Booking Re-opened"}
			}
		}
		form guest_profile
		{
			displayname = "Guest Profile"
			success message = "Guest Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			guest_name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_proof_number
			(
    			type = text
				displayname = "ID Proof Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			number_of_guests
			(
				type = number
				displayname = "Number of Guests"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			permanent_address
			(
    			type = address
				displayname = "Permanent Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type
			(
				type = picklist
				displayname = "Room Type"
				values = {"Executive Suite","Presidential Suite","Deluxe Single Room","Deluxe Double Room","Family Suite"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			meal_plan
			(
				type = picklist
				displayname = "Meal Plan"
				values = {"Breakfast Included","Room Only","All Meals Included"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			amenities_required
			(
				type = list	
				displayname = "Amenities Required"
				values = {"Extra Bed","Airport Pickup","Late Checkout","Welcome Drink","Spa Access","Laundry Service","Room Service","Mini Bar"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			special_requests
			(
    			type = textarea
				displayname = "Special Requests"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_date
			(
    			type = date
				displayname = "Check-In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_checkin_time
			(
    			type = time
				displayname = "Preferred Check-in Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			agree_to_hotel_policies
			(
    			type = checkbox
				displayname = "Agree to Hotel Policies"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list booking_record_Report
		{
			displayName = "All Records"
			show all rows from booking_record    
			(
				guest as "Guest"
				booking_status as "Booking Status"
				created_at as "Created At"
			)
		}
		kanban booking_record_by_booking_status
		{
			displayName = "Booking Statuses"
			show all rows from booking_record    
			(
				guest as "Guest"
				booking_status as "Booking Status"
				created_at as "Created At"
			)
			options
			(
	 			display field = booking_status
	 		)
		}
		list guest_profile_Report
		{
			displayName = "All Guest Profiles"
			show all rows from guest_profile    
			(
				guest_name  as "Guest Name"
				id_proof_number as "ID Proof Number"
				number_of_guests as "Number of Guests"
				email_address as "Email Address"
				contact_number as "Contact Number"
				permanent_address  as "Permanent Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				room_type as "Room Type"
				meal_plan as "Meal Plan"
				amenities_required as "Amenities Required"
				special_requests as "Special Requests"
				check_in_date as "Check-In Date"
				preferred_checkin_time as "Preferred Check-in Time"
				agree_to_hotel_policies as "Agree to Hotel Policies"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (room_type == "Deluxe Single Room")
				fields = [room_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (room_type == "Executive Suite")
				fields = [room_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (room_type == "Family Suite")
				fields = [room_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (room_type == "Presidential Suite")
				fields = [room_type]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban guest_profile_by_room_type
		{
			displayName = "Room Types"
			show all rows from guest_profile    
			(
				guest_name  as "Guest Name"
				id_proof_number as "ID Proof Number"
				number_of_guests as "Number of Guests"
				email_address as "Email Address"
				contact_number as "Contact Number"
				permanent_address  as "Permanent Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				room_type as "Room Type"
				meal_plan as "Meal Plan"
				amenities_required as "Amenities Required"
				special_requests as "Special Requests"
				check_in_date as "Check-In Date"
				preferred_checkin_time as "Preferred Check-in Time"
				agree_to_hotel_policies as "Agree to Hotel Policies"
			)
			options
			(
	 			display field = room_type
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
